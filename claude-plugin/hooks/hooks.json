{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "A=/Applications/Airine.app/Contents/MacOS/airine; [ -x \"$A\" ] || exit 0; exec \"$A\" doporuceni --hook", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "A=/Applications/Airine.app/Contents/MacOS/airine; [ -x \"$A\" ] || exit 0; exec \"$A\" nahlas --hook", "timeout": 5 }
        ]
      }
    ]
  }
}
